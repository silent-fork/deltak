# ---------------------------------------------------------------------------
# Delta-K Terminal — backend engine configuration (prefix: DK_)
# Copy to backend/.env. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# -- server ------------------------------------------------------------------
DK_HOST=0.0.0.0
DK_PORT=8000
DK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- Angel One SmartAPI ------------------------------------------------------
# Optional pre-fill for the login modal. The six-digit TOTP is ALWAYS entered by
# the user at login time from their authenticator app — it is never stored here.
DK_API_KEY=
DK_CLIENT_CODE=

# Angel One whitelists the public IP your BACKEND calls from. This must match
# the "Primary Static IP" registered on your SmartAPI app.
DK_CLIENT_LOCAL_IP=127.0.0.1
DK_CLIENT_PUBLIC_IP=127.0.0.1
DK_MAC_ADDRESS=00:00:00:00:00:00

# -- execution ---------------------------------------------------------------
DK_EXECUTION_MODE=paper
DK_PAPER_CAPITAL=500000
DK_PAPER_SLIPPAGE_PCT=0.0015
DK_PRODUCT_TYPE=INTRADAY

# -- risk --------------------------------------------------------------------
DK_RISK_PCT_PER_TRADE=1.0
DK_MAX_CONCURRENT_POSITIONS=4
DK_INVALIDATION_PCT=0.35

# -- persistence (Supabase) --------------------------------------------------
# The service-role key bypasses RLS: server-side only, never in the browser.
DK_SUPABASE_URL=https://<project-ref>.supabase.co
DK_SUPABASE_SERVICE_KEY=

# -- development -------------------------------------------------------------
# Drives the HUD from a synthetic tick generator when no SmartAPI session
# exists. The UI labels this feed as SIMULATED.
DK_SIMULATE=0
