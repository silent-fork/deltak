# ---------------------------------------------------------------------------
# Delta-K Terminal (serverless) — Vercel environment variables
# ---------------------------------------------------------------------------

# Angel One SmartAPI private key. Server-side only: the login route reads it
# from here so it is never in the client bundle or the request body.
#
# Note: it IS returned to the browser after a successful login, because the
# SmartStream WebSocket is opened by the page and authenticates via query
# string. That pair (apiKey + feedToken) is market-data scoped — it subscribes
# to quotes and cannot place orders. The order-placing JWT stays in an httpOnly
# cookie.
DK_API_KEY=

# Angel One expects these client identity headers on every REST call.
DK_CLIENT_LOCAL_IP=127.0.0.1
DK_CLIENT_PUBLIC_IP=127.0.0.1
DK_MAC_ADDRESS=00:00:00:00:00:00
DK_PRODUCT_TYPE=INTRADAY

# Persistence. The service-role key bypasses RLS — server-side only, and never
# prefixed NEXT_PUBLIC_.
#
# Tables: user_profiles, positions, orders, risk_events. The profile is written
# after each getProfile; trades are attributed to the client code from the
# session cookie, never from the request body.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts the Angel One session (JWT + refresh token) stored in
# `broker_sessions` for background jobs — a risk watchdog reading prices or
# managing positions with no browser tab open. Base64-encoded, 32 raw bytes:
# generate with `openssl rand -base64 32`. Server-side only, never prefixed
# NEXT_PUBLIC_. Leaving this unset does not degrade anything — every function
# in lib/server/brokerSession.ts is a no-op without it, so the watchdog
# feature is off by construction until this is set.
DK_SESSION_ENC_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — human verification in front of the broker login.
# ---------------------------------------------------------------------------
#
# The widget is non-interactive: the operator sees the sign-in button spin, and
# nothing else. Only a visitor Cloudflare wants to challenge ever sees anything.
#
# The site key is public by design (it is rendered into the page). The secret
# verifies the token server-side and must never be prefixed NEXT_PUBLIC_.
# Create both at https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_DK_TURNSTILE_SITE_KEY=
DK_TURNSTILE_SECRET_KEY=

# The switch, read by the browser *and* the server so the two never disagree
# about whether a token is expected. Set to 0 (or false/off) to take the gate
# out of the path entirely — for local work and end-to-end tests that drive the
# real login form. Anything else, including unset, leaves it on.
#
# With the switch on but no secret configured, logins still proceed: the check
# turns itself on only once there is a secret to verify against.
NEXT_PUBLIC_DK_TURNSTILE_ENABLED=1

# Set to 1 to drive the HUD from a synthetic tick generator when no SmartAPI
# session exists. The UI shows a persistent SIMULATED FEED badge while active.
NEXT_PUBLIC_SIMULATE=0
