# ---------------------------------------------------------------------------
# Delta-K Terminal (serverless) — Vercel environment variables
# ---------------------------------------------------------------------------

# Angel One SmartAPI private key. Server-side only: the login route reads it
# from here so it is never in the client bundle or the request body.
#
# Note: it IS returned to the browser after a successful login, because the
# SmartStream WebSocket is opened by the page and authenticates via query
# string. That pair (apiKey + feedToken) is market-data scoped — it subscribes
# to quotes and cannot place orders. The order-placing JWT stays in an httpOnly
# cookie.
DK_API_KEY=

# Angel One expects these client identity headers on every REST call.
DK_CLIENT_LOCAL_IP=127.0.0.1
DK_CLIENT_PUBLIC_IP=127.0.0.1
DK_MAC_ADDRESS=00:00:00:00:00:00
DK_PRODUCT_TYPE=INTRADAY

# Persistence. The service-role key bypasses RLS — server-side only, and never
# prefixed NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to drive the HUD from a synthetic tick generator when no SmartAPI
# session exists. The UI shows a persistent SIMULATED FEED badge while active.
NEXT_PUBLIC_SIMULATE=0
