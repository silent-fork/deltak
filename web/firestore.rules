rules_version = '2';

// /discuss's actual access control — not this repo's code, this file,
// deployed straight to Firestore (`firebase deploy --only firestore:rules`,
// or pasted into the console under Firestore → Rules). Nothing in
// lib/server/forum.ts or firestore.ts can see past what this grants: there
// is no service-role bypass the way lib/supabase.ts has one for the trading
// tables (see firestore.ts's own header comment for why). A fresh Firestore
// database denies every request until this is deployed — "it works in dev"
// against an emulator or a test-mode project proves nothing about whether
// this file is actually live in production.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reads a *different* document mid-rule-evaluation to answer "is the
    // caller a moderator" — the one place these rules look outside the
    // document being evaluated. Costs a read against the caller's own quota
    // on every moderator-gated check, which is the standard, accepted cost
    // of role-based Firestore rules; there's no cheaper way to ask "what
    // role does this token's owner have" from inside a rule.
    function isModerator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/forumProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/forumProfiles/$(request.auth.uid)).data.role == 'moderator';
    }

    // Profiles: public read (a byline needs a display name without forcing
    // a login just to view a thread), self-create. Never client-deletable —
    // a departing member's post history staying attributable is the
    // intended behavior, same as the app's own trading tables never
    // hard-delete a position.
    //
    // Update is deliberately split by field: the owner can rename
    // themselves, but never touch their own `role` — the account that
    // wrote this comment originally left that unrestricted, which let any
    // signed-in user grant themselves `moderator` with a single PATCH.
    // Only an existing moderator can change *anyone's* role now, including
    // granting the first one — which makes the very first moderator (and
    // this app's feed-ingestion bot, see forumFeedItems below) a manual
    // grant via the Firebase console, not something the app can bootstrap
    // through its own rules. Console writes go through Firebase's own
    // admin path, not these rules, so that bootstrap step is unaffected by
    // anything written here.
    match /forumProfiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isSignedIn() && (
        (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])) ||
        isModerator()
      );
      allow delete: if false;
    }

    match /forumThreads/{threadId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      // Two different callers legitimately patch a thread: its own author
      // (or a moderator) editing/locking it, and *any* signed-in member
      // replying — which only ever touches replyCount/lastActivityAt, never
      // the title or lock state. `affectedKeys()` is what tells those apart.
      allow update: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isModerator() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastActivityAt'])
      );
      allow delete: if false;

      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
        // Three legitimate callers on a post: its own author editing the
        // body or soft-deleting it (never authorUid/authorName/createdAt —
        // those stay fixed once written), a moderator with no such field
        // restriction, and *any* signed-in member liking it, which only
        // ever touches likeCount.
        allow update: if isSignedIn() && (
          (resource.data.authorUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt', 'deletedAt'])) ||
          isModerator() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        );
        allow delete: if false;

        // One doc per liker, keyed on their own uid — its mere existence
        // is the like; there is nothing in it worth reading, but public
        // read keeps a like count's provenance auditable the same way
        // everything else here is.
        match /likes/{uid} {
          allow read: if true;
          allow create: if isOwner(uid);
          allow delete: if isOwner(uid);
          allow update: if false;
        }
      }
    }

    // Reports: anyone signed in can file one (write-only from their side —
    // they can't read the queue back, which would leak who reported what to
    // the reporter and to anyone else). Only moderators can read/resolve.
    match /forumReports/{reportId} {
      allow read: if isModerator();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isModerator();
      allow delete: if false;
    }

    // Dedup bookkeeping for RSS-ingested threads — doc ID is a hash of the
    // source item's link, value is which thread it became. Nothing in the
    // UI ever reads this; it exists purely so a cron run doesn't create a
    // second thread for a story it already posted. Moderator-gated because
    // the ingestion route authenticates as the feed bot's own account,
    // which is granted that role manually (see forumProfiles above) —
    // there is no separate "service account" concept in these rules.
    match /forumFeedItems/{itemId} {
      allow read, write: if isModerator();
    }
  }
}
